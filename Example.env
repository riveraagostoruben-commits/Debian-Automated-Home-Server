O
# ============================================================
# RUBEN'S ARR STACK
# PROTON VPN FREE
# ============================================================


# ============================================================
# SYSTEM
# ============================================================

TZ=

# Verify with: id
PUID=1000
PGID=1000


# ============================================================
# PROTON VPN FREE
# ============================================================

VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=openvpn

# Copy PrivateKey from the Proton WireGuard .conf file.
WIREGUARD_PRIVATE_KEY= private key

OPENVPN_USER= username
OPENVPN_PASSWORD=password


# IMPORTANT:
# Copy the actual Address from the Proton .conf file.
# Example only: 10.2.0.2/32
WIREGUARD_ADDRESSES=10.2.0.2/32

OPENVPN_PROTOCOL=tcp
OPENVPN_ENDPOINT_PORT=443

# Only select Proton Free servers.
FREE_ONLY=on

# You can keep United States, or remove the country filter
# if Gluetun has trouble finding a free server.
SERVER_COUNTRIES=


# ============================================================
# DOCKER NETWORK
# ============================================================

IP_GLUETUN=172.39.0.2
IP_RADARR=172.39.0.3
IP_SONARR=172.39.0.4
IP_BAZARR=172.39.0.6
IP_JELLYFIN=172.39.0.7
IP_SEERR=172.39.0.8
